BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# SQLite database path. Relative paths are resolved from the project root.
DATABASE_PATH=antifake.db

# Your Telegram ID. Multiple admins: 111111,222222
ADMIN_IDS=486192692

# Channel where approved fact-checks are published. Example: @AntiFakeUA or -1001234567890
CHANNEL_ID=@AntiFakeUA

# Optional transparency links
GITHUB_URL=https://github.com/And2Ex/AntiFakeUA_Bot
METHODOLOGY_URL=https://github.com/And2Ex/AntiFakeUA_Bot/blob/main/METHODOLOGY.md

# Free checks per calendar month
FREE_TEXT_LIMIT=30

# LiqPay payment settings
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
LIQPAY_SANDBOX=1

# Public HTTPS URL for callbacks, for example https://xxxx.ngrok-free.app
BASE_WEBHOOK_URL=

# Optional URL opened after payment. Can be your bot link or channel.
PAYMENT_RESULT_URL=https://t.me/AntiFakeUA_Bot

# Optional donation/support link shown only after successful sandbox payment
SUPPORT_JAR_URL=https://send.monobank.ua/jar/AgE5cQTo4P
