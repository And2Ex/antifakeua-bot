# Channel where approved fact-checks are published. Example: @AntiFakeUA or -1001234567890
CHANNEL_ID=@AntiFakeUA

# Optional transparency links
GITHUB_URL=https://github.com/And2Ex/AntiFakeUA_Bot
METHODOLOGY_URL=https://github.com/And2Ex/AntiFakeUA_Bot/blob/main/METHODOLOGY.md


# Public HTTPS URL of the Web Service, without a trailing slash.
